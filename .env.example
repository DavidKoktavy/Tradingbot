# ── Trading mode ─────────────────────────────────────────────────────
# One of: BACKTEST, SIMULATION, PAPER, LIVE
# Default is PAPER. LIVE requires the two flags below as well.
TRADING_MODE=PAPER

# LIVE trading is refused unless BOTH of these are set correctly.
# This is intentionally awkward to flip by accident.
ENABLE_LIVE_TRADING=false
LIVE_TRADING_CONFIRMATION=

# ── Interactive Brokers (TWS / IB Gateway) ──────────────────────────
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ACCOUNT_ID=
# live | frozen | delayed | delayed_frozen
# "live" needs a real-time data subscription. A fresh account (especially
# paper) often has none — set this to "delayed" to get 15-20 minute old
# quotes with no subscription required, enough to prove connectivity and
# explore the system. The risk engine will correctly refuse to actually
# trade on data this old, so switch back to "live" before running `paper`
# for real. See scripts/smoke_test_ibkr.py --market-data-type.
IBKR_MARKET_DATA_TYPE=live

# ── AI provider ──────────────────────────────────────────────────────
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=

# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trading_agent:changeme@localhost:5432/trading_agent

# ── Risk limits (defaults only — not investment advice) ─────────────
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_PORTFOLIO_DRAWDOWN=0.10
MAX_POSITION_SIZE=0.10
MAX_SECTOR_EXPOSURE=0.30
MAX_GROSS_EXPOSURE=1.00
MAX_OPEN_POSITIONS=10
MAX_ORDERS_PER_MINUTE=20
MAX_MARKET_DATA_AGE_SECONDS=5

# ── Logging / monitoring ────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
